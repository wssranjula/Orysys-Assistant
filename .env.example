# Local endpoints and runtime
APP_ENV=development
APP_NAME=Commercial Bank AI Assistant
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
UI_API_BASE_URL=http://localhost:8000

# POC bearer tokens (replace for any shared environment)
AUTH_VIEWER_TOKEN=replace-with-viewer-token
AUTH_ANALYST_TOKEN=replace-with-analyst-token
AUTH_ADMIN_TOKEN=replace-with-administrator-token
AUTH_APPROVER_TOKEN=replace-with-approver-token

# Retrieval and embedding adapters
RETRIEVAL_BACKEND=memory
PINECONE_API_KEY=
PINECONE_INDEX=commercial-bank-assistant
PINECONE_NAMESPACE=commercial-bank
PINECONE_HOST=
OPENAI_API_KEY=
AGENT_MODEL=gpt-5-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RETRIEVAL_DENSE_WEIGHT=0.65
RETRIEVAL_SPARSE_WEIGHT=0.35
RETRIEVAL_CANDIDATE_COUNT=20
RETRIEVAL_MIN_SPARSE_SCORE=0.1
RETRIEVAL_RETRY_ATTEMPTS=2
RETRIEVAL_RERANKING_ENABLED=true
RETRIEVAL_RERANKER_LEXICAL_WEIGHT=0.25

# Agent execution budgets, enforced as middleware rather than prompt guidance.
# The root spends its tool calls on delegations; each specialist may be consulted once per turn.
ROOT_MAX_TOOL_CALLS=8
ROOT_MAX_MODEL_CALLS=6
SPECIALIST_MAX_TOOL_CALLS=6
SPECIALIST_MAX_MODEL_CALLS=5
SPECIALIST_OVERALL_TIMEOUT_SECONDS=45

# Section-aware chunking (merge_sections=false yields one chunk per markdown section)
CHUNK_TARGET_TOKENS=650
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=80
CHUNK_MERGE_SECTIONS=false

# Bounded recursive research
RESEARCH_MAX_TOTAL_TOOL_CALLS=20
RESEARCH_MAX_MODEL_CALLS=12
RESEARCH_MAX_CHUNKS_PER_WORKER=6
RESEARCH_SUMMARIZATION_TOKEN_TRIGGER=40000
RESEARCH_OVERALL_TIMEOUT_SECONDS=90

# PostgreSQL conversation memory and Redis token buckets
POSTGRES_DB=orysys_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orysys_assistant
MEMORY_BACKEND=memory
MEMORY_MAX_RECENT_MESSAGES=20
MEMORY_MAX_SUMMARY_CHARACTERS=8000
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_VIEWER_CAPACITY=10
RATE_LIMIT_VIEWER_REFILL_PER_MINUTE=5
RATE_LIMIT_ANALYST_CAPACITY=30
RATE_LIMIT_ANALYST_REFILL_PER_MINUTE=15
RATE_LIMIT_ADMINISTRATOR_CAPACITY=60
RATE_LIMIT_ADMINISTRATOR_REFILL_PER_MINUTE=30
AUTH_LOGIN_RATE_LIMIT_CAPACITY=10
AUTH_LOGIN_RATE_LIMIT_REFILL_PER_MINUTE=5

# Read-only enterprise MCP and controlled analysis
MCP_BACKEND=memory
MCP_SERVER_URL=http://localhost:8100/mcp
MCP_TIMEOUT_SECONDS=10
MCP_RETRY_ATTEMPTS=1
MCP_MAX_RESULT_BYTES=100000
ANALYSIS_MAX_RECORDS=1000
REQUEST_TIMEOUT_SECONDS=120
LLM_RETRY_ATTEMPTS=1

# LangSmith (auto-enabled in development when LANGSMITH_API_KEY is set)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=commercial-bank-assistant
LANGSMITH_QUIET_MIDDLEWARE_TRACES=true
MOCK_TOKEN_DELAY_SECONDS=0.025
